server {

	listen 443 ssl;

	ssl_certificate $BOOKINGS_TENANT_ADMIN_SSL_CERT ;
	# e.g.  /etc/letsencrypt/live/whatever/fullchain.pem;

	ssl_certificate_key $BOOKINGS_TENANT_ADMIN_SSL_KEY ;
	# e.g. /etc/letsencrypt/live/whatever/privkey.pem;

	server_name $BOOKINGS_TENANT_ADMIN_SERVER_NAME ;

	location / {
		root /opt/tenant_admin/html;
	}

	location /api/ {
		proxy_pass http://superapi:5000/;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-Prefix $http_x_forwarded_prefix;
	}
}